# =============================================================
# BROKEN TUNES — Variables de entorno
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env
# NUNCA commitees el archivo .env al repositorio
# =============================================================

# --- Base de datos ---
DB_HOST=database        # nombre del servicio en docker-compose
DB_USER=root
DB_PASS=12345
DB_NAME=broken_tunes2

# --- Flask ---
FLASK_DEBUG=False

# --- MySQL root (usado por docker-compose) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=broken_tunes2
MYSQL_USER=root
MYSQL_PASSWORD=12345

# --- FTP ---
FTP_USER=
FTP_PASS=